# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local Python environments
.venv/
venv/
env/

# Node dependencies and package-manager noise
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local secrets and machine-specific environment files
.env
.env.*
!.env.example
!.env.template

# Editors and operating-system metadata
.idea/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and generated process files
*.tmp
*.temp
*.pid
*.log

# Build and packaging output
build/
dist/
*.egg-info/

# Local third-party SillyTavern/KoboldCpp installation; never repository state.
SillyTavern_UI/_local_runtime/

# Evaluation-independent LM Studio runtime captures
# Keep LM-Studio_logs/README.md and the stream structure publishable.
LM-Studio_logs/server_events/*
LM-Studio_logs/model_lifecycle_events/*
LM-Studio_logs/model_io_events/*
LM-Studio_logs/host_resource_snapshots/*
!LM-Studio_logs/server_events/.gitkeep
!LM-Studio_logs/model_lifecycle_events/.gitkeep
!LM-Studio_logs/model_io_events/.gitkeep
!LM-Studio_logs/host_resource_snapshots/.gitkeep

# Project-owned local runtime observability captures.
# logs/README.md remains tracked; owner/stream JSON captures stay machine-local.
logs/**/*.json

MY ACC$.MD
